# Copiar a .env y ajustar si hace falta.
# Rama todo-en-uno: los defaults NO requieren nada externo — el LLM Bonsai
# es el servicio `bonsai` de este mismo compose (la primera ejecución baja
# el modelo ~2 GB desde HuggingFace y queda persistido en el volumen).

# Web: puerto del host si el 8090 está ocupado.
WEB_PORT=8090

# LLM Bonsai INTERNO (API OpenAI-compatible en la red de compose).
# Para usar un Bonsai EXTERNO (p. ej. el del repo ollamaLocal en el host):
#   BONSAI_BASE_URL=http://host.docker.internal:4687/v1
BONSAI_BASE_URL=http://bonsai:8080/v1
BONSAI_MODEL=ternary-bonsai-8b
BONSAI_TIMEOUT=180
# Llamadas concurrentes máximas al LLM (lotes grandes saturan el host sin tope).
BONSAI_CONCURRENCIA=4

# Modelo que descarga/arranca el servicio bonsai (fork PrismML de llama.cpp, CPU).
BONSAI_GGUF=Ternary-Bonsai-8B-PQ2_0.gguf
BONSAI_HF_REPO=prism-ml/Ternary-Bonsai-8B-gguf
BONSAI_CTX=8192
# Puerto del host para debug directo del Bonsai (http://localhost:4688).
BONSAI_HOST_PORT=4688
# ¿HuggingFace bloqueado en tu red? Pon el GGUF en una carpeta local y
# descomenta (el entrypoint lo detecta y no intenta descargar):
# BONSAI_MODELS_BIND=./models

# doi2bib.org: pestañas paralelas y cortesía (rate limit ~60-70 en ráfaga)
DOI2BIB_TABS=10
DOI2BIB_MIN_INTERVALO=1.0
DOI2BIB_REINTENTOS=2
DOI2BIB_PAUSA_RATE_LIMIT=60

# Búsqueda por nombre (Google→DuckDuckGo→Bing + Crossref)
BUSCADOR_TABS=2
BUSCADOR_DELAY=2.5
CANDIDATOS_A_VERIFICAR=4
